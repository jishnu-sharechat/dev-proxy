#!/usr/bin/env python3
"""proxyctl - control a mitmproxy instance for Android debug work.

This is the single entry point an agent or a person uses. It starts the proxy,
points the Android device at it, installs the CA certificate, queries captured
traffic, and edits the interception rules.

Run `proxyctl help` for the command list.
"""

import argparse
import functools
import http.server
import json
import os
import re
import secrets
import shutil
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
VAR = ROOT / "var"
BODIES = VAR / "bodies"
MAPS = ROOT / "maps"
RULES_FILE = ROOT / "rules" / "rules.json"
FLOWS_FILE = VAR / "flows.jsonl"
DUMP_FILE = VAR / "flows.mitm"
PID_FILE = VAR / "mitmproxy.pid"
LOG_FILE = VAR / "mitm.log"
READY_FILE = VAR / "ready"
CONFIG_FILE = ROOT / "config.json"
ADDON = ROOT / "addon" / "claude_addon.py"
CA_DIR = Path.home() / ".mitmproxy"
CA_PEM = CA_DIR / "mitmproxy-ca-cert.pem"
CA_KEY_PEM = CA_DIR / "mitmproxy-ca.pem"  # cert + private key, used to sign the MQTT leaf
MQTT_DIR = VAR / "mqtt"
MQTT_CONF = MQTT_DIR / "mosquitto.conf"
MQTT_PID_FILE = MQTT_DIR / "broker.pid"
MQTT_LOG_FILE = MQTT_DIR / "broker.log"
MQTT_CA_CERT = MQTT_DIR / "ca.crt"
MQTT_BROKER_CERT = MQTT_DIR / "broker.crt"
MQTT_BROKER_KEY = MQTT_DIR / "broker.key"
MQTT_DEFAULT_PORT = 8883
WEBUI_DIR = ROOT / "webui"
WEB_PID_FILE = VAR / "webui.pid"
WEB_LOG_FILE = VAR / "webui.log"
UPDATE_STAMP = VAR / "update_check.json"
SKILL_SRC = ROOT / "skill" / "SKILL.md"
SKILL_DST = Path.home() / ".claude" / "skills" / "dev-proxy" / "SKILL.md"

DEFAULT_BYPASS = ["localhost", "127.0.0.1", "10.0.2.2", "*.local"]

DEFAULTS = {
    "port": 8080,
    "web_port": 8081,
    "dashboard_port": 8090,
    "package": "",
    "adb": "",
    "mitmdump": "",
    "proxy_bypass": DEFAULT_BYPASS,
    "main_activity": "",
    "web_password": "",
    "app_hosts": [],
}

C = {
    "dim": "\033[2m", "red": "\033[31m", "green": "\033[32m",
    "yellow": "\033[33m", "cyan": "\033[36m", "bold": "\033[1m", "off": "\033[0m",
}
if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
    C = {k: "" for k in C}


def die(msg, code=1):
    print(f"{C['red']}error:{C['off']} {msg}", file=sys.stderr)
    sys.exit(code)


def info(msg):
    print(f"{C['cyan']}==>{C['off']} {msg}")


def ok(msg):
    print(f"{C['green']}ok{C['off']} {msg}")


def warn(msg):
    print(f"{C['yellow']}note:{C['off']} {msg}")


# ------------------------------------------------------------------ config

def load_config():
    cfg = dict(DEFAULTS)
    if CONFIG_FILE.exists():
        try:
            cfg.update(json.loads(CONFIG_FILE.read_text() or "{}"))
        except json.JSONDecodeError as exc:
            die(f"config.json is not valid JSON: {exc}")
    cfg["adb"] = cfg["adb"] or _find_adb()
    cfg["mitmdump"] = cfg["mitmdump"] or shutil.which("mitmdump") or "/opt/homebrew/bin/mitmdump"
    return cfg


def save_config(cfg):
    keep = {k: v for k, v in cfg.items() if k in DEFAULTS}
    CONFIG_FILE.write_text(json.dumps(keep, indent=2) + "\n")


def _find_adb():
    found = shutil.which("adb")
    if found:
        return found
    for candidate in (
        Path.home() / "Library/Android/sdk/platform-tools/adb",
        Path("/usr/local/bin/adb"),
    ):
        if candidate.exists():
            return str(candidate)
    return "adb"


def adb(cfg, *args, check=False, capture=True, serial=None):
    cmd = [cfg["adb"]]
    serial = serial or os.environ.get("ANDROID_SERIAL")
    if serial:
        cmd += ["-s", serial]
    cmd += [str(a) for a in args]
    try:
        res = subprocess.run(
            cmd, capture_output=capture, text=True, check=False
        )
    except FileNotFoundError:
        die(f"adb not found ({cfg['adb']!r}). Install it: "
            "brew install --cask android-platform-tools")
    if check and res.returncode != 0:
        die(f"adb {' '.join(str(a) for a in args)} failed: {(res.stderr or res.stdout).strip()}")
    return res


def devices(cfg):
    out = adb(cfg, "devices").stdout or ""
    found = []
    for line in out.splitlines()[1:]:
        if "\tdevice" in line:
            found.append(line.split("\t")[0])
    return found


# ------------------------------------------------------------------- proxy

def read_pid():
    if not PID_FILE.exists():
        return None
    try:
        pid = int(PID_FILE.read_text().strip())
    except (ValueError, OSError):
        return None
    try:
        os.kill(pid, 0)
    except OSError:
        return None
    return pid


def cmd_start(cfg, args):
    if read_pid():
        warn(f"proxy already runs on port {cfg['port']} (pid {read_pid()})")
        return
    for d in (VAR, BODIES, MAPS, RULES_FILE.parent):
        d.mkdir(parents=True, exist_ok=True)
    if not RULES_FILE.exists():
        RULES_FILE.write_text(json.dumps({"capture": {}, "rules": []}, indent=2) + "\n")

    port = args.port or cfg["port"]
    cmd = [
        cfg["mitmdump"],
        "-q",  # addon diagnostics go to var/addon.log instead
        "-s", str(ADDON),
        "--listen-port", str(port),
        "--set", "connection_strategy=lazy",
        "--set", "stream_large_bodies=10m",
        "-w", str(DUMP_FILE),
    ]
    if args.web:
        # mitmweb, unset, generates a random login token each start and prints
        # it to the console. In mitmproxy 12.2.3 that printed token does not
        # match what the server actually checks (confirmed: a manual login
        # with it fails "Invalid Password" even copied byte for byte from the
        # log). A password we set ourselves works every time, so use that
        # instead of the broken auto-token flow.
        if not cfg.get("web_password"):
            cfg["web_password"] = secrets.token_hex(12)
            save_config(cfg)
        cmd = [
            cfg["mitmdump"].replace("mitmdump", "mitmweb"),
            "-s", str(ADDON),
            "--listen-port", str(port),
            "--web-port", str(cfg["web_port"]),
            "--web-host", "127.0.0.1",
            "--no-web-open-browser",
            "--set", f"web_password={cfg['web_password']}",
            "--set", "connection_strategy=lazy",
            "--set", "stream_large_bodies=10m",
            "-w", str(DUMP_FILE),
        ]
    if args.insecure:
        cmd += ["--ssl-insecure"]
    if args.upstream:
        cmd += ["--mode", f"upstream:{args.upstream}"]

    # Unbuffered, or the mitmweb login token sits in a stdio buffer and never
    # reaches the log file while the process keeps running — only on exit.
    env = dict(os.environ, DEVPROXY_HOME=str(ROOT), PYTHONUNBUFFERED="1")
    READY_FILE.unlink(missing_ok=True)
    with LOG_FILE.open("a") as logfh:
        logfh.write(f"\n=== start {time.strftime('%Y-%m-%d %H:%M:%S')} ===\n")
        proc = subprocess.Popen(
            cmd, stdout=logfh, stderr=subprocess.STDOUT, env=env,
            start_new_session=True,
        )
    # Wait for the addon, not just for the process. mitmdump accepts traffic
    # before the addon finishes loading, and those early flows escape the rules.
    for _ in range(120):
        if proc.poll() is not None:
            print(LOG_FILE.read_text()[-2000:])
            die("mitmproxy exited immediately. See the log above.")
        if READY_FILE.exists():
            break
        time.sleep(0.25)
    else:
        die("the addon did not report ready within 30s. Check " + str(LOG_FILE))
    PID_FILE.write_text(str(proc.pid))
    cfg["port"] = port
    save_config(cfg)
    ok(f"proxy listens on 0.0.0.0:{port} (pid {proc.pid})")
    if args.web:
        ok(f"mitmweb at http://127.0.0.1:{cfg['web_port']}/?token={cfg['web_password']}")
        print(f"  or open http://127.0.0.1:{cfg['web_port']}/ and enter the "
              f"password: {cfg['web_password']}")
    print(f"  log:   {LOG_FILE}")
    print(f"  flows: {FLOWS_FILE}")
    print(f"  rule warnings: {VAR / 'addon.log'}")


def cmd_stop(cfg, args):
    pid = read_pid()
    if not pid:
        warn("proxy is not running")
        PID_FILE.unlink(missing_ok=True)
        return
    os.kill(pid, signal.SIGTERM)
    for _ in range(20):
        time.sleep(0.2)
        try:
            os.kill(pid, 0)
        except OSError:
            break
    else:
        os.kill(pid, signal.SIGKILL)
    PID_FILE.unlink(missing_ok=True)
    READY_FILE.unlink(missing_ok=True)
    ok(f"proxy stopped (pid {pid})")


def cmd_restart(cfg, args):
    cmd_stop(cfg, args)
    time.sleep(0.5)
    cmd_start(cfg, args)


def cmd_status(cfg, args):
    pid = read_pid()
    print(f"{C['bold']}proxy{C['off']}    " + (
        f"{C['green']}running{C['off']} pid {pid} port {cfg['port']}" if pid
        else f"{C['red']}stopped{C['off']}"
    ))
    print(f"{C['bold']}ca cert{C['off']}  " + (
        f"{CA_PEM}" if CA_PEM.exists() else f"{C['red']}missing{C['off']} (start the proxy once)"
    ))
    wpid = read_web_pid()
    print(f"{C['bold']}dashboard{C['off']} " + (
        f"{C['green']}http://127.0.0.1:{cfg['dashboard_port']}/webui/{C['off']}" if wpid
        else f"{C['dim']}off{C['off']} (run `proxyctl web on`)"
    ))
    devs = devices(cfg)
    print(f"{C['bold']}devices{C['off']}  " + (", ".join(devs) if devs else f"{C['red']}none{C['off']}"))
    if devs:
        proxy = (adb(cfg, "shell", "settings", "get", "global", "http_proxy").stdout or "").strip()
        rev = (adb(cfg, "reverse", "--list").stdout or "").strip()
        print(f"{C['bold']}device proxy{C['off']} {proxy or 'null'}")
        broken = proxy.startswith("127.0.0.1") and f"tcp:{cfg['port']}" not in rev
        print(f"{C['bold']}adb reverse{C['off']}  " + (rev or "none")
              + (f"  {C['red']}<- missing, no traffic can arrive. "
                 f"Run `proxyctl device on`.{C['off']}" if broken else ""))
    rules = read_rules()
    active = [r for r in rules.get("rules", []) if r.get("enabled", True)]
    print(f"{C['bold']}rules{C['off']}    {len(active)} active / {len(rules.get('rules', []))} total")
    for r in rules.get("rules", []):
        mark = f"{C['green']}on {C['off']}" if r.get("enabled", True) else f"{C['dim']}off{C['off']}"
        kinds = ",".join(
            a.get("type", "?") for a in _as_list(r.get("action") or r.get("actions") or [])
        )
        print(f"  {mark} {r.get('id','?'):<12} {kinds:<14} {r.get('name','')}")
    n = sum(1 for _ in FLOWS_FILE.open()) if FLOWS_FILE.exists() else 0
    print(f"{C['bold']}flows{C['off']}    {n} captured")
    upd = update_check()
    if upd and upd.get("behind"):
        warn(f"update available: {upd['behind']} commit(s) behind origin/main. "
             "Run `proxyctl update`.")


# ------------------------------------------------------------------ device

def cmd_device(cfg, args):
    if not devices(cfg):
        die("no adb device. Connect the device and enable USB debugging.")
    port = cfg["port"]
    if args.action == "on":
        if args.lan:
            host = args.lan if args.lan is not True else _lan_ip()
            target = f"{host}:{port}"
        else:
            adb(cfg, "reverse", f"tcp:{port}", f"tcp:{port}", check=True)
            target = f"127.0.0.1:{port}"
        host, _, tport = target.rpartition(":")
        adb(cfg, "shell", "settings", "put", "global", "http_proxy", target, check=True)
        adb(cfg, "shell", "settings", "put", "global", "global_http_proxy_host", host)
        adb(cfg, "shell", "settings", "put", "global", "global_http_proxy_port", tport)
        # Without a bypass list the global proxy also swallows the React Native
        # Metro connection on localhost:8081, so the JS bundle never loads.
        bypass = ",".join(cfg.get("proxy_bypass") or DEFAULT_BYPASS)
        adb(cfg, "shell", "settings", "put", "global",
            "global_http_proxy_exclusion_list", bypass)
        ok(f"device proxy set to {target}")
        print(f"  bypass: {bypass}")
        warn("restart the app so it picks up the new proxy")
    else:
        proxy, left = device_off(cfg)
        if proxy not in ("null", "") or left:
            warn(f"device still shows http_proxy={proxy or 'unset'}"
                 + (f", reverse tunnel tcp:{port} still active" if left else "")
                 + ". Clear by hand: adb shell settings delete global http_proxy")
        else:
            ok("device proxy removed and verified clear")


def device_off(cfg, serial=None):
    """Remove the proxy wiring from one device.

    Returns (remaining_proxy_setting, reverse_tunnel_still_present) so the
    caller can verify the device really is clear.
    """
    port = cfg["port"]
    adb(cfg, "shell", "settings", "put", "global", "http_proxy", ":0", serial=serial)
    for key in ("http_proxy", "global_http_proxy_host", "global_http_proxy_port",
                "global_http_proxy_exclusion_list"):
        adb(cfg, "shell", "settings", "delete", "global", key, serial=serial)
    adb(cfg, "reverse", "--remove", f"tcp:{port}", serial=serial)
    proxy = (adb(cfg, "shell", "settings", "get", "global",
                 "http_proxy", serial=serial).stdout or "").strip()
    rev = adb(cfg, "reverse", "--list", serial=serial).stdout or ""
    return proxy, f"tcp:{port}" in rev


def ensure_reverse(cfg, quiet=False):
    """Re-add the adb reverse tunnel if it went away.

    The tunnel dies whenever the adb server restarts or the cable re-enumerates,
    but the device keeps its http_proxy setting. Traffic then goes nowhere and
    the flow log looks empty for no visible reason.
    """
    if not devices(cfg):
        return False
    port = cfg["port"]
    proxy = (adb(cfg, "shell", "settings", "get", "global",
                 "http_proxy").stdout or "").strip()
    if not proxy.startswith("127.0.0.1"):
        return False
    rev = adb(cfg, "reverse", "--list").stdout or ""
    if f"tcp:{port}" in rev:
        return False
    adb(cfg, "reverse", f"tcp:{port}", f"tcp:{port}")
    if not quiet:
        warn(f"the adb reverse tunnel was missing. Restored tcp:{port}.")
    return True


def _lan_ip():
    for iface in ("en0", "en1"):
        res = subprocess.run(["ipconfig", "getifaddr", iface], capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    die("cannot detect a LAN IP address. Pass --lan <ip>.")


# -------------------------------------------------------------------- cert

def cmd_cert(cfg, args):
    if not CA_PEM.exists():
        die("CA certificate not found. Run `proxyctl start` once, then retry.")
    if args.mode == "path":
        print(CA_PEM)
        return
    if args.mode == "system":
        _cert_system(cfg)
        return
    _cert_user(cfg)


def _cert_hash(cfg):
    res = subprocess.run(
        ["openssl", "x509", "-inform", "PEM", "-subject_hash_old", "-in", str(CA_PEM)],
        capture_output=True, text=True, check=False,
    )
    if res.returncode != 0:
        die(f"openssl failed: {res.stderr.strip()}")
    return res.stdout.strip().splitlines()[0]


def _cert_user(cfg):
    if not devices(cfg):
        die("no adb device.")
    name = "mitmproxy-ca.crt"
    target = f"/sdcard/Download/{name}"
    adb(cfg, "push", str(CA_PEM), target, check=True)
    # Trigger a media scan so the file picker sees the file straight away.
    adb(cfg, "shell", "am", "broadcast", "-a",
        "android.intent.action.MEDIA_SCANNER_SCAN_FILE", "-d", f"file://{target}")
    ok(f"pushed the certificate to {target}")
    # This intent opens the CA installer file picker directly, which is far
    # shorter than walking the Settings tree.
    adb(cfg, "shell", "am", "start", "-a", "android.credentials.INSTALL")
    print(f"""
{C['bold']}Finish the install on the device. You do this only once.{C['off']}
  1. A file picker is now open on the device.
  2. Open the {C['cyan']}Downloads{C['off']} folder.
  3. Tap {C['cyan']}{name}{C['off']}.
  4. Accept the name, then tap OK. Confirm "Install anyway" if asked.

Android will warn that a third party can watch the traffic. That warning is
correct. It describes this proxy. Keep the certificate only on a test device.

Then run: {C['cyan']}proxyctl cert verify{C['off']}

If the picker does not show the file, open Settings yourself:
  Biometrics and security > Other security settings >
  Install from device storage > CA certificate
""")


def _cert_system(cfg):
    """Install the CA into the system store. Emulator or rooted device only."""
    if not devices(cfg):
        die("no adb device.")
    info("switching adb to root")
    adb(cfg, "root")
    time.sleep(2)
    adb(cfg, "wait-for-device")
    if "cannot" in (adb(cfg, "root").stdout or "").lower():
        die("this device does not allow adb root. Use `proxyctl cert` instead, "
            "or start the emulator with -writable-system.")

    name = f"{_cert_hash(cfg)}.0"
    adb(cfg, "push", str(CA_PEM), f"/data/local/tmp/{name}", check=True)
    apex = "/apex/com.android.conscrypt/cacerts"
    has_apex = adb(cfg, "shell", f"test -d {apex} && echo yes").stdout.strip() == "yes"

    if has_apex:
        info("using the APEX bind-mount route (Android 14+)")
        script = (
            "set -e; "
            "mkdir -p /data/local/tmp/cacopy; "
            f"cp {apex}/* /data/local/tmp/cacopy/; "
            f"cp /data/local/tmp/{name} /data/local/tmp/cacopy/{name}; "
            "chown root:root /data/local/tmp/cacopy/*; "
            "chmod 644 /data/local/tmp/cacopy/*; "
            f"mount --bind /data/local/tmp/cacopy {apex}; "
            "echo bound"
        )
        res = adb(cfg, "shell", "su", "0", "sh", "-c", f"'{script}'")
        if "bound" not in (res.stdout or ""):
            res = adb(cfg, "shell", script)
        if "bound" not in (res.stdout or ""):
            die(f"bind mount failed: {(res.stderr or res.stdout).strip()}")
        ok("certificate installed into the system store")
        warn("the bind mount disappears on reboot. Re-run this command after a reboot.")
    else:
        adb(cfg, "remount", check=False)
        res = adb(cfg, "shell", f"cp /data/local/tmp/{name} /system/etc/security/cacerts/{name} "
                                f"&& chmod 644 /system/etc/security/cacerts/{name} && echo copied")
        if "copied" not in (res.stdout or ""):
            die(f"copy into /system failed: {(res.stderr or res.stdout).strip()}")
        ok("certificate installed into /system/etc/security/cacerts")


def cmd_cert_verify(cfg, args):
    if not read_pid():
        die("proxy is not running. Run `proxyctl start` first.")
    ensure_reverse(cfg)
    pkg = require_package(cfg)
    before = _flow_count()
    info(f"restarting {pkg} and watching for HTTPS traffic")
    adb(cfg, "shell", "am", "force-stop", pkg)
    time.sleep(1)
    start_app(cfg, pkg)
    # Wait for decrypted HTTPS, not just for any flow. Metro polls localhost and
    # Google services fail on their own pinning, so the first few flows arrive
    # fast and prove nothing. Stopping on a raw count misreports a working setup.
    def _classify():
        new = _read_flows()[before:]
        https = [f for f in new if f.get("url", "").startswith("https")]
        return (
            new,
            https,
            [f for f in https if f.get("status")],
            [f for f in https if f.get("error")],
        )

    for _ in range(max(args.wait, 8)):
        time.sleep(1)
        _, _, good, _ = _classify()
        if len(good) >= 3:
            break
    new, https, good, bad = _classify()
    print(f"  new flows: {len(new)}   https: {len(https)}   "
          f"decrypted: {len(good)}   failed: {len(bad)}")
    if good:
        ok(f"HTTPS decryption works. The certificate is trusted. "
           f"{len(good)}/{len(https)} HTTPS flows decrypted.")
        hosts = sorted({f["host"] for f in good})
        print(f"  decrypted hosts: {', '.join(hosts[:8])}")
        # Optional: name your own backends in config.json as "app_hosts" and
        # this reports on them specifically. Third party SDK traffic decrypting
        # does not prove your API does.
        patterns = cfg.get("app_hosts") or []
        if patterns:
            mine = [h for h in hosts
                    if any(re.search(p, h, re.I) for p in patterns)]
            if mine:
                ok(f"your backends decrypt: {', '.join(mine)}")
            else:
                warn("none of your app_hosts decrypted yet. Open a screen that "
                     "calls your API, then re-run.")
        if bad:
            warn(f"{len(bad)} HTTPS flow(s) still fail. Google and Play hosts "
                 "pin their own certificates, so that is normal.")
    elif https:
        die("HTTPS flows appear but none decrypt. The CA is not trusted by the app.\n"
            "  - Confirm the build is debuggable and trusts user CAs.\n"
            "  - Re-run `proxyctl cert`.")
    else:
        die("no traffic reached the proxy. Run `proxyctl device on` and retry.")


# ------------------------------------------------------------------- flows

def _read_flows():
    if not FLOWS_FILE.exists():
        return []
    out = []
    for line in FLOWS_FILE.read_text(errors="replace").splitlines():
        if not line.strip():
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return out


def _flow_count():
    return sum(1 for _ in FLOWS_FILE.open()) if FLOWS_FILE.exists() else 0


def _filter(flows, args):
    out = []
    for f in flows:
        if args.host and not re.search(args.host, f.get("host", ""), re.I):
            continue
        if args.url and not re.search(args.url, f.get("url", ""), re.I):
            continue
        if args.method and f.get("method", "").upper() != args.method.upper():
            continue
        if args.status and str(f.get("status") or "") != str(args.status):
            continue
        if args.errors and not f.get("error"):
            continue
        if args.mocked and not f.get("mocked") and not f.get("rules"):
            continue
        if args.grep:
            blob = json.dumps(f)
            if not re.search(args.grep, blob, re.I):
                continue
        if args.min_ms and (f.get("duration_ms") or 0) < args.min_ms:
            continue
        out.append(f)
    return out


def cmd_flows(cfg, args):
    flows = _filter(_read_flows(), args)
    if args.last:
        flows = flows[-args.last:]
    if args.json:
        print(json.dumps(flows, indent=2))
        return
    if not flows:
        print("no matching flows")
        return
    print(f"{'ID':>6}  {'TIME':<8} {'ST':>3} {'MS':>6} {'METH':<6} {'SIZE':>8}  URL")
    for f in flows:
        st = f.get("status")
        colour = C["green"] if st and st < 400 else (C["red"] if st else C["yellow"])
        stxt = str(st) if st else ("ERR" if f.get("error") else "-")
        size = _human(f.get("resp_size", 0))
        url = f.get("url", "")
        if len(url) > 88:
            url = url[:85] + "..."
        tag = ""
        if f.get("mocked"):
            tag = f" {C['yellow']}[mock]{C['off']}"
        elif f.get("rules"):
            tag = f" {C['cyan']}[{','.join(f['rules'])}]{C['off']}"
        print(f"{f.get('id'):>6}  {f.get('time',''):<8} {colour}{stxt:>3}{C['off']} "
              f"{f.get('duration_ms') or '-':>6} {f.get('method',''):<6} {size:>8}  {url}{tag}")
    print(f"{C['dim']}{len(flows)} flow(s). Use `proxyctl show <ID>` for detail.{C['off']}")


def _human(n):
    for unit in ("B", "K", "M"):
        if n < 1024:
            return f"{n:.0f}{unit}"
        n /= 1024
    return f"{n:.1f}G"


def cmd_show(cfg, args):
    flows = {str(f.get("id")): f for f in _read_flows()}
    f = flows.get(str(args.id))
    if not f:
        die(f"no flow with id {args.id}")
    if args.json:
        print(json.dumps(f, indent=2))
        return
    print(f"{C['bold']}#{f['id']}  {f.get('method')} {f.get('url')}{C['off']}")
    print(f"  status {f.get('status')}   {f.get('duration_ms')} ms   "
          f"req {_human(f.get('req_size',0))} / resp {_human(f.get('resp_size',0))}")
    if f.get("mapped_to"):
        print(f"  {C['yellow']}mapped to: {f['mapped_to']}{C['off']}")
    if f.get("rules"):
        print(f"  {C['cyan']}rules applied: {', '.join(f['rules'])}{C['off']}")
    if f.get("mocked"):
        print(f"  {C['yellow']}served locally: {f['mocked']}{C['off']}")
    if f.get("error"):
        print(f"  {C['red']}error: {f['error']}{C['off']}")
    if not args.body_only:
        print(f"\n{C['bold']}request headers{C['off']}")
        for k, v in (f.get("req_headers") or {}).items():
            print(f"  {k}: {v}")
        print(f"\n{C['bold']}response headers{C['off']}")
        for k, v in (f.get("resp_headers") or {}).items():
            print(f"  {k}: {v}")
    for side, label in (("req", "request body"), ("resp", "response body")):
        path = f.get(f"{side}_body_file")
        preview = f.get(f"{side}_preview")
        if not (path or preview):
            continue
        print(f"\n{C['bold']}{label}{C['off']}"
              + (f" {C['dim']}({ROOT / path}){C['off']}" if path else ""))
        if args.full and path and (ROOT / path).exists():
            print((ROOT / path).read_text(errors="replace"))
        else:
            print(preview)


def cmd_body(cfg, args):
    flows = {str(f.get("id")): f for f in _read_flows()}
    f = flows.get(str(args.id))
    if not f:
        die(f"no flow with id {args.id}")
    path = f.get(f"{args.side}_body_file")
    if not path:
        die(f"flow {args.id} has no saved {args.side} body")
    print(ROOT / path)


def _clear_flows():
    FLOWS_FILE.unlink(missing_ok=True)
    for p in BODIES.glob("*"):
        if p.is_file():
            p.unlink()
    # The running mitmdump holds var/flows.mitm open. Deleting it here would
    # send every later write to an unlinked inode and break `proxyctl har`.
    # A restart reopens the file, so only reset it when the proxy is down.
    if not read_pid():
        DUMP_FILE.unlink(missing_ok=True)


def cmd_clear(cfg, args):
    _clear_flows()
    ok("flow log and saved bodies cleared. Ids restart at 1.")
    if read_pid():
        warn("the raw dump (for `proxyctl har`) still covers this whole proxy run. "
             "Run `proxyctl restart` first if you need a clean HAR.")


def cmd_tail(cfg, args):
    info("following new flows. Press Ctrl-C to stop.")
    seen = _flow_count()
    try:
        while True:
            flows = _read_flows()
            for f in flows[seen:]:
                st = f.get("status") or ("ERR" if f.get("error") else "-")
                tag = f" [{','.join(f.get('rules', []))}]" if f.get("rules") else ""
                print(f"{f.get('id'):>6} {f.get('time')} {str(st):>3} "
                      f"{f.get('method'):<5} {f.get('url', '')[:100]}{tag}")
            seen = len(flows)
            time.sleep(0.7)
    except KeyboardInterrupt:
        print()


# ------------------------------------------------------------------- rules

def read_rules():
    if not RULES_FILE.exists():
        return {"capture": {}, "rules": []}
    try:
        return json.loads(RULES_FILE.read_text() or "{}")
    except json.JSONDecodeError as exc:
        die(f"rules.json is not valid JSON: {exc}")


def write_rules(data):
    """Write rules.json atomically.

    The addon rereads this file on every request. A plain write lets a request
    read a half-written file, which silently drops every rule for that request.
    """
    tmp = RULES_FILE.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n")
    tmp.replace(RULES_FILE)


def _toggle_rule(rule_id, enabled):
    """Enable/disable one rule by id. Returns False if the id doesn't exist."""
    data = read_rules()
    match = next((r for r in data.get("rules", []) if r.get("id") == rule_id), None)
    if match is None:
        return False
    match["enabled"] = enabled
    write_rules(data)
    return True


def _as_list(v):
    return v if isinstance(v, list) else [v]


def cmd_rules(cfg, args):
    data = read_rules()
    rules = data.setdefault("rules", [])

    if args.action == "list":
        print(json.dumps(data, indent=2))

    elif args.action == "add":
        raw = args.json or sys.stdin.read()
        try:
            new = json.loads(raw)
        except json.JSONDecodeError as exc:
            die(f"rule is not valid JSON: {exc}")
        for rule in _as_list(new):
            rule.setdefault("enabled", True)
            rule.setdefault("id", f"r{len(rules) + 1}")
            _validate_rule(rule)
            rules[:] = [r for r in rules if r.get("id") != rule["id"]]
            rules.append(rule)
            ok(f"rule {rule['id']} added")
        write_rules(data)

    elif args.action in ("rm", "remove"):
        if not args.id:
            die("pass a rule id")
        before = len(rules)
        data["rules"] = [r for r in rules if r.get("id") not in args.id]
        write_rules(data)
        ok(f"removed {before - len(data['rules'])} rule(s)")

    elif args.action in ("enable", "disable"):
        if not args.id:
            die("pass a rule id, or `all`")
        want = args.action == "enable"
        n = 0
        for r in rules:
            if "all" in args.id or r.get("id") in args.id:
                r["enabled"] = want
                n += 1
        write_rules(data)
        ok(f"{args.action}d {n} rule(s)")

    elif args.action == "clear":
        data["rules"] = []
        write_rules(data)
        ok("all rules removed")

    elif args.action == "capture":
        if args.json:
            data["capture"] = json.loads(args.json)
            write_rules(data)
        print(json.dumps(data.get("capture", {}), indent=2))


VALID_ACTIONS = {
    "map_local", "map_remote", "block", "delay", "status",
    "set_header", "body_replace", "json_patch",
}


def _validate_rule(rule):
    if not rule.get("match"):
        die(f"rule {rule.get('id')} has no `match` block")
    actions = _as_list(rule.get("action") or rule.get("actions") or [])
    if not actions:
        die(f"rule {rule.get('id')} has no `action`")
    for a in actions:
        kind = a.get("type")
        if kind not in VALID_ACTIONS:
            die(f"unknown action type {kind!r}. Valid: {', '.join(sorted(VALID_ACTIONS))}")
        if kind == "map_local":
            p = Path(a.get("file", ""))
            p = p if p.is_absolute() else ROOT / p
            if not p.exists():
                die(f"map_local file does not exist: {p}")


# ------------------------------------------------------------------ extras

def cmd_replay(cfg, args):
    """Send a captured request again, through the proxy, so rules apply."""
    flows = {str(f.get("id")): f for f in _read_flows()}
    f = flows.get(str(args.id))
    if not f:
        die(f"no flow with id {args.id}")
    if not read_pid():
        die("proxy is not running")
    body = None
    path = f.get("req_body_file")
    if path and (ROOT / path).exists():
        body = (ROOT / path).read_bytes()
    req = urllib.request.Request(f["url"], data=body, method=f.get("method", "GET"))
    skip = {"host", "content-length", "accept-encoding", "connection"}
    for k, v in (f.get("req_headers") or {}).items():
        if k.lower() not in skip:
            req.add_header(k, v)
    proxy = f"http://127.0.0.1:{cfg['port']}"
    opener = urllib.request.build_opener(
        urllib.request.ProxyHandler({"http": proxy, "https": proxy})
    )
    import ssl
    ctx = ssl.create_default_context(cafile=str(CA_PEM)) if CA_PEM.exists() else None
    if ctx:
        opener.add_handler(urllib.request.HTTPSHandler(context=ctx))
    try:
        with opener.open(req, timeout=args.timeout) as resp:
            print(f"{resp.status} {resp.reason}  {len(resp.read())} bytes")
    except urllib.error.HTTPError as exc:
        print(f"{exc.code} {exc.reason}  {len(exc.read())} bytes")
    except (urllib.error.URLError, OSError) as exc:
        die(f"replay failed: {exc}")
    ok("replayed. The new flow is at the end of `proxyctl flows`.")


def cmd_har(cfg, args):
    if not DUMP_FILE.exists():
        die("no raw flow dump yet. Capture some traffic first.")
    out = Path(args.out).expanduser().resolve()
    res = subprocess.run(
        [cfg["mitmdump"], "-nr", str(DUMP_FILE), "--set", f"hardump={out}", "-q"],
        capture_output=True, text=True,
    )
    if res.returncode != 0 or not out.exists():
        die(f"HAR export failed: {(res.stderr or res.stdout).strip()}")
    ok(f"HAR written to {out}")


def require_package(cfg):
    pkg = cfg.get("package")
    if not pkg:
        die('no app package set. Add "package": "com.your.app" to config.json '
            "(copy config.example.json if you have not yet).")
    return pkg


def main_activity(cfg, pkg):
    """Resolve the launcher activity of a package.

    Debug builds of this app ship LeakCanary, which registers its own launcher
    activity. `monkey` then starts LeakCanary instead of the app, and no
    backend traffic ever appears. So pick the real activity explicitly.
    """
    if cfg.get("main_activity"):
        return cfg["main_activity"]
    out = adb(cfg, "shell", "cmd", "package", "query-activities", "--brief",
              "-a", "android.intent.action.MAIN",
              "-c", "android.intent.category.LAUNCHER").stdout or ""
    hits = [
        line.strip() for line in out.splitlines()
        if line.strip().startswith(f"{pkg}/") and "leakcanary" not in line.lower()
    ]
    if not hits:
        return None
    cfg["main_activity"] = hits[0]
    save_config(cfg)
    return hits[0]


def start_app(cfg, pkg):
    comp = main_activity(cfg, pkg)
    if comp:
        adb(cfg, "shell", "am", "start", "-n", comp, check=True)
        return comp
    adb(cfg, "shell", "monkey", "-p", pkg, "-c",
        "android.intent.category.LAUNCHER", "1", check=True)
    return f"{pkg} (via monkey)"


def cmd_app(cfg, args):
    pkg = args.package or require_package(cfg)
    ensure_reverse(cfg)
    if args.action in ("restart", "stop"):
        adb(cfg, "shell", "am", "force-stop", pkg, check=True)
        ok(f"stopped {pkg}")
    if args.action in ("restart", "start"):
        time.sleep(0.8)
        ok(f"started {start_app(cfg, pkg)}")


def read_web_pid():
    if not WEB_PID_FILE.exists():
        return None
    try:
        pid = int(WEB_PID_FILE.read_text().strip())
    except (ValueError, OSError):
        return None
    try:
        os.kill(pid, 0)
    except OSError:
        return None
    return pid


class DashboardRouteError(Exception):
    """A route's way of asking for a specific HTTP status, e.g. 404 for an
    unknown id, rather than the generic 500 an unexpected exception gets."""

    def __init__(self, status, message):
        super().__init__(message)
        self.status = status


def _route_toggle_rule(body):
    try:
        payload = json.loads(body or b"{}")
    except json.JSONDecodeError:
        raise DashboardRouteError(400, "malformed JSON body")
    rule_id, enabled = payload.get("id"), payload.get("enabled")
    if not rule_id or not isinstance(enabled, bool):
        raise DashboardRouteError(400, 'expected {"id": str, "enabled": bool}')
    if not _toggle_rule(rule_id, enabled):
        raise DashboardRouteError(404, f"unknown rule id {rule_id!r}")
    return {"ok": True}


def _route_app_restart(body):
    """Restart the app under test, same as `proxyctl app restart`."""
    cfg = load_config()
    pkg = cfg.get("package")
    if not pkg:
        raise DashboardRouteError(400, 'no app package set. Fill "package" in config.json.')
    if not devices(cfg):
        raise DashboardRouteError(409, "no adb device connected")
    ensure_reverse(cfg, quiet=True)
    adb(cfg, "shell", "am", "force-stop", pkg)
    time.sleep(0.8)
    return {"ok": True, "started": start_app(cfg, pkg)}


def _route_devices(body=None):
    """List adb devices and whether each one routes through this proxy."""
    cfg = load_config()
    port = cfg["port"]
    out = []
    for serial in devices(cfg):
        model = (adb(cfg, "shell", "getprop", "ro.product.model",
                     serial=serial).stdout or "").strip()
        proxy = (adb(cfg, "shell", "settings", "get", "global",
                     "http_proxy", serial=serial).stdout or "").strip()
        if proxy in ("null", ":0"):
            proxy = ""
        rev = adb(cfg, "reverse", "--list", serial=serial).stdout or ""
        has_reverse = f"tcp:{port}" in rev
        # A loopback proxy needs the reverse tunnel to carry traffic. A LAN
        # proxy reaches this machine over the network on its own.
        active = bool(proxy) and (has_reverse if proxy.startswith("127.0.0.1") else True)
        out.append({
            "serial": serial,
            "model": model,
            "proxy": proxy or None,
            "reverse": has_reverse,
            "active": active,
        })
    return {"ok": True, "port": port, "devices": out}


def _route_device_disconnect(body):
    try:
        payload = json.loads(body or b"{}")
    except json.JSONDecodeError:
        raise DashboardRouteError(400, "malformed JSON body")
    serial = payload.get("serial")
    cfg = load_config()
    devs = devices(cfg)
    if not devs:
        raise DashboardRouteError(409, "no adb device connected")
    if serial and serial not in devs:
        raise DashboardRouteError(404, f"unknown device {serial!r}")
    proxy, rev_left = device_off(cfg, serial=serial)
    clear = proxy in ("null", "") and not rev_left
    return {"ok": True, "clear": clear, "proxy": proxy or None}


def _route_mqtt_status(body=None):
    """Local MQTT broker state for the dashboard panel."""
    cfg = load_config()
    port = MQTT_DEFAULT_PORT
    reverse = False
    if devices(cfg):
        rev = adb(cfg, "reverse", "--list").stdout or ""
        reverse = f"tcp:{port}" in rev
    return {
        "ok": True,
        "running": bool(_mqtt_broker_pid()),
        "port": port,
        "reverse": reverse,
        "mosquitto": _mosquitto_bin("mosquitto") is not None,
        "override": f"ssl://127.0.0.1:{port}",
    }


def _route_mqtt_broker(body):
    """Start or stop the local broker from the dashboard."""
    try:
        payload = json.loads(body or b"{}")
    except json.JSONDecodeError:
        raise DashboardRouteError(400, "malformed JSON body")
    action = payload.get("action")
    cfg = load_config()
    if action == "start":
        if not _mosquitto_bin("mosquitto"):
            raise DashboardRouteError(400, "mosquitto is not installed. Run: brew install mosquitto")
        if not CA_KEY_PEM.exists():
            raise DashboardRouteError(400, "mitmproxy CA not found. Run `proxyctl start` once.")
        _mqtt_broker_start(cfg, MQTT_DEFAULT_PORT)
    elif action == "stop":
        _mqtt_broker_stop(cfg, MQTT_DEFAULT_PORT)
    else:
        raise DashboardRouteError(400, 'expected {"action": "start"|"stop"}')
    return _route_mqtt_status()


def _route_mqtt_pub(body):
    """Publish one message to the local broker, the paste-and-send path."""
    try:
        payload = json.loads(body or b"{}")
    except json.JSONDecodeError:
        raise DashboardRouteError(400, "malformed JSON body")
    topic = (payload.get("topic") or "").strip()
    message = payload.get("payload")
    if not topic or message is None:
        raise DashboardRouteError(400, 'expected {"topic": str, "payload": str}')
    if not _mqtt_broker_pid():
        raise DashboardRouteError(409, "the local broker is not running. Start it first.")
    qos = payload.get("qos")
    qos = int(qos) if qos in (0, 1, 2, "0", "1", "2") else 1
    ok_pub, msg = _mqtt_publish(topic, str(message), "127.0.0.1",
                                MQTT_DEFAULT_PORT, qos, bool(payload.get("retain")))
    if not ok_pub:
        raise DashboardRouteError(502, msg)
    return {"ok": True, "topic": topic, "message": msg}


DASHBOARD_ROUTES = {
    "/api/clear": lambda body: (_clear_flows(), {"ok": True})[1],
    "/api/rules/toggle": _route_toggle_rule,
    "/api/app/restart": _route_app_restart,
    "/api/device/disconnect": _route_device_disconnect,
    "/api/mqtt/broker": _route_mqtt_broker,
    "/api/mqtt/pub": _route_mqtt_pub,
}

def _route_version(body=None):
    """Local version plus the cached behind-origin count for the header."""
    stamp = update_check() or {}
    return {
        "ok": True,
        "version": local_version(),
        "behind": int(stamp.get("behind") or 0),
    }


DASHBOARD_GET_ROUTES = {
    "/api/devices": _route_devices,
    "/api/version": _route_version,
    "/api/mqtt/status": _route_mqtt_status,
}


def _dashboard_same_origin(handler):
    """True unless the browser explicitly flags this as a cross-site request.

    A malicious page open in another tab could otherwise POST to this
    loopback-only, unauthenticated server and silently wipe local state.
    Sec-Fetch-Site is sent by every evergreen browser on fetch(); direct
    curl/script use sends no such header and is allowed through unchanged.
    """
    site = handler.headers.get("Sec-Fetch-Site")
    return site is None or site == "same-origin"


def _make_dashboard_handler():
    class Handler(http.server.SimpleHTTPRequestHandler):
        def log_message(self, fmt, *a):
            pass  # proxyctl web redirects this process's stdout/stderr to WEB_LOG_FILE already

        def end_headers(self):
            # A cached page hides UI updates behind a hard refresh nobody
            # does. Everything here is local and cheap; never cache it.
            self.send_header("Cache-Control", "no-store")
            super().end_headers()

        def _run_route(self, route, body):
            try:
                result = route(body)
                status = 200
            except DashboardRouteError as exc:
                result = {"ok": False, "error": str(exc)}
                status = exc.status
            except SystemExit:
                # A route reached die(). Keep the server thread alive and
                # report the failure instead. Details are in the web log.
                result = {"ok": False, "error": "the command failed. See var/webui.log."}
                status = 500
            except Exception as exc:
                result = {"ok": False, "error": str(exc)}
                status = 500
            payload = json.dumps(result).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)

        def do_GET(self):
            route = DASHBOARD_GET_ROUTES.get(self.path.split("?")[0])
            if route is None:
                super().do_GET()
                return
            self._run_route(route, b"")

        def do_POST(self):
            route = DASHBOARD_ROUTES.get(self.path)
            if route is None:
                self.send_error(404)
                return
            if not _dashboard_same_origin(self):
                self.send_error(403, "cross-origin request rejected")
                return
            length = int(self.headers.get("Content-Length") or 0)
            body = self.rfile.read(length) if length else b""
            self._run_route(route, body)

    return functools.partial(Handler, directory=str(ROOT))


def cmd_serve_dashboard(cfg, args):
    """Internal: run the dashboard's HTTP server in the foreground.

    `web on` spawns this as a detached subprocess — it is not meant to be run
    directly, which is why it is hidden from `proxyctl help`.
    """
    server = http.server.ThreadingHTTPServer(("127.0.0.1", args.port), _make_dashboard_handler())
    server.serve_forever()


def cmd_web(cfg, args):
    """Serve the live dashboard: a flow list next to a detail inspector.

    The dashboard page polls var/flows.jsonl and rules/rules.json itself, and
    posts to a couple of small JSON routes (see DASHBOARD_ROUTES) for actions
    that need to touch state on disk — everything else is served as a plain
    static file, same-origin, so those fetches are not blocked.
    """
    port = cfg["dashboard_port"]
    url = f"http://127.0.0.1:{port}/webui/"

    if args.action == "status":
        pid = read_web_pid()
        print(f"{C['bold']}dashboard{C['off']}  " + (
            f"{C['green']}running{C['off']} pid {pid}  {url}" if pid
            else f"{C['red']}stopped{C['off']}"
        ))
        return

    if args.action == "off":
        pid = read_web_pid()
        if not pid:
            warn("dashboard is not running")
            WEB_PID_FILE.unlink(missing_ok=True)
            return
        os.kill(pid, signal.SIGTERM)
        WEB_PID_FILE.unlink(missing_ok=True)
        ok("dashboard stopped")
        return

    # action == "on"
    if read_web_pid():
        ok(f"dashboard already running at {url}")
        return
    with WEB_LOG_FILE.open("a") as logfh:
        proc = subprocess.Popen(
            [sys.executable, str(Path(__file__).resolve()), "_serve", str(port)],
            stdout=logfh, stderr=subprocess.STDOUT, start_new_session=True,
        )
    time.sleep(0.5)
    if proc.poll() is not None:
        die(f"the dashboard server did not start. See {WEB_LOG_FILE}")
    WEB_PID_FILE.write_text(str(proc.pid))
    ok(f"dashboard at {url}")
    print(f"  It polls var/flows.jsonl once a second. No refresh needed.")
    if args.open:
        subprocess.run(["open", url])


def _git(*a, timeout=None):
    return subprocess.run(["git", "-C", str(ROOT), *a],
                          capture_output=True, text=True, timeout=timeout)


def local_version():
    if not (ROOT / ".git").exists():
        return None
    return _git("rev-parse", "--short", "HEAD").stdout.strip() or None


def update_check(force=False):
    """Compare local HEAD with origin/main, at most once a day.

    Returns {checked_at, behind, local} or None when unknown. Never blocks
    long and never fails loudly. Offline is a normal state: the fetch is
    skipped and the count runs against the last-known origin/main.
    """
    if not (ROOT / ".git").exists():
        return None
    stamp = {}
    if UPDATE_STAMP.exists():
        try:
            stamp = json.loads(UPDATE_STAMP.read_text())
        except (json.JSONDecodeError, OSError):
            stamp = {}
    now = time.time()
    if not force and now - stamp.get("checked_at", 0) < 86400:
        return stamp or None
    try:
        _git("fetch", "--quiet", "origin", "main", timeout=6)
    except (subprocess.TimeoutExpired, OSError):
        pass
    try:
        behind = int(_git("rev-list", "--count", "HEAD..origin/main").stdout.strip())
    except ValueError:
        behind = 0
    stamp = {"checked_at": now, "behind": behind, "local": local_version()}
    try:
        VAR.mkdir(parents=True, exist_ok=True)
        UPDATE_STAMP.write_text(json.dumps(stamp))
    except OSError:
        pass
    return stamp


def regenerate_skill():
    """Write the installed skill from skill/SKILL.md, same as install.sh."""
    if not SKILL_SRC.exists():
        return False
    SKILL_DST.parent.mkdir(parents=True, exist_ok=True)
    SKILL_DST.write_text(SKILL_SRC.read_text().replace("__DEVPROXY_HOME__", str(ROOT)))
    return True


def cmd_update(cfg, args):
    """Pull the latest dev-proxy and refresh everything that consumes it."""
    if not (ROOT / ".git").exists():
        die("this dev-proxy is not a git clone, so it cannot self-update")
    info("pulling the latest dev-proxy")
    res = _git("pull", "--ff-only")
    if res.returncode != 0:
        die(f"git pull failed: {(res.stderr or res.stdout).strip()}")
    summary = (res.stdout or "").strip().splitlines()
    if summary:
        print("  " + summary[-1])
    if regenerate_skill():
        ok(f"skill regenerated at {SKILL_DST}")
    # The dashboard process holds the old server code. Pure HTML changes only
    # need a browser refresh, but new routes need a new process.
    if read_web_pid():
        info("restarting the dashboard server")
        cmd_web(cfg, argparse.Namespace(action="off", open=False))
        cmd_web(cfg, argparse.Namespace(action="on", open=False))
        print("  refresh the dashboard tab in the browser")
    if read_pid():
        warn("the running proxy still uses the old addon code. "
             "Run `proxyctl restart` when the current capture can stop.")
    update_check(force=True)
    ok(f"dev-proxy is at {local_version() or 'unknown'}")


def cmd_setup(cfg, args):
    """One command that gets everything ready."""
    info("step 1/4 start the proxy")
    cmd_start(cfg, argparse.Namespace(port=None, web=False, insecure=False, upstream=None))
    info("step 2/4 point the device at the proxy")
    cmd_device(cfg, argparse.Namespace(action="on", lan=None))
    info("step 3/4 install the CA certificate")
    _cert_user(cfg)
    info("step 4/4 after the taps above, run `proxyctl cert verify`")


def cmd_paths(cfg, args):
    """List dotted JSON paths in a captured response body.

    This exists so a json_patch path can be verified against the real
    response before a rule is written. A user-typed field name often has a
    typo or the wrong capitalization; a rule made from it silently never
    applies.
    """
    flows = {str(f.get("id")): f for f in _read_flows()}
    f = flows.get(str(args.id))
    if not f:
        die(f"no flow with id {args.id}")
    src = f.get("resp_body_file")
    if not src or not (ROOT / src).exists():
        die(f"flow {args.id} has no saved response body")
    try:
        data = json.loads((ROOT / src).read_text(errors="replace"))
    except json.JSONDecodeError as exc:
        die(f"the response body is not JSON: {exc}")

    rows = []

    def walk(node, prefix):
        if isinstance(node, dict):
            for k, v in node.items():
                walk(v, f"{prefix}.{k}" if prefix else str(k))
        elif isinstance(node, list):
            if not node:
                rows.append((prefix, "[]"))
            else:
                # One element is enough to learn the shape. Every index of a
                # 500-item feed would bury the useful paths.
                walk(node[0], f"{prefix}.0")
                if len(node) > 1:
                    rows.append((f"{prefix}.1..{len(node) - 1}", f"[{len(node)} items total]"))
        else:
            rows.append((prefix, json.dumps(node)))

    walk(data, "")
    query = (args.query or "").lower()
    hits = [(p, v) for p, v in rows if query in p.lower()] if query else rows
    if not hits:
        print(f"no path contains {args.query!r}. "
              f"Rerun without a query to list all {len(rows)} paths.")
        return
    shown = hits[: args.limit]
    for p, v in shown:
        val = v if len(v) <= 80 else v[:77] + "..."
        print(f"  {p} = {val}")
    if len(hits) > len(shown):
        print(f"  ... {len(hits) - len(shown)} more. Narrow with a query, "
              f"or raise --limit.")


def cmd_map(cfg, args):
    """Map a URL to a local file. The user edits the file; the proxy serves it.

    Different from `mock`: it needs no captured flow. It creates the file when
    the file is missing, and seeds it from the newest matching captured
    response when one exists.
    """
    host_re = args.host if args.regex else re.escape(args.host)
    path_re = args.path if args.regex else "^" + re.escape(args.path)
    name = args.name or (re.sub(r"[^a-zA-Z0-9]+", "_", args.path).strip("_") or "map")
    target = Path(args.file).expanduser() if args.file else MAPS / f"{name}.json"
    if not target.is_absolute():
        target = ROOT / target
    created = False
    if not target.exists():
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(_seed_body(args.host, args.path))
        created = True
    try:
        file_ref = str(target.relative_to(ROOT))
    except ValueError:
        file_ref = str(target)
    rule_id = args.rule_id or f"map_{name}"[:40]
    rule = {
        "id": rule_id,
        "name": f"map local for {args.path}",
        "enabled": True,
        "match": {"host": host_re, "path": path_re},
        "action": {
            "type": "map_local",
            "file": file_ref,
            "status": args.status,
            "content_type": args.content_type,
        },
    }
    data = read_rules()
    data.setdefault("rules", [])
    data["rules"] = [r for r in data["rules"] if r.get("id") != rule_id]
    data["rules"].append(rule)
    write_rules(data)
    ok(("created " if created else "using existing ") + str(target))
    ok(f"rule {rule_id} added")
    print("  Edit the file. The next matching request serves the new content.")
    print("  No restart is needed. The proxy reads the file on every request.")


def _seed_body(host, path):
    """Newest captured response body for host+path, or an empty JSON object."""
    for f in reversed(_read_flows()):
        if f.get("host") == host and f.get("path") == path and f.get("resp_body_file"):
            p = ROOT / f["resp_body_file"]
            if p.exists():
                info(f"seeded the file from captured flow #{f.get('id')}")
                return p.read_text(errors="replace")
    return "{\n}\n"


def cmd_mock(cfg, args):
    """Shortcut: capture a real response, save it, and serve it locally."""
    flows = {str(f.get("id")): f for f in _read_flows()}
    f = flows.get(str(args.id))
    if not f:
        die(f"no flow with id {args.id}")
    src = f.get("resp_body_file")
    if not src or not (ROOT / src).exists():
        die(f"flow {args.id} has no saved response body to seed the mock")
    name = args.name or (re.sub(r"[^a-zA-Z0-9]+", "_", f.get("path", "mock")).strip("_") or "mock")
    ext = Path(src).suffix or ".json"
    target = MAPS / f"{name}{ext}"
    target.write_bytes((ROOT / src).read_bytes())
    rule = {
        "id": args.rule_id or f"mock_{name}"[:40],
        "name": f"map local for {f.get('path')}",
        "enabled": True,
        "match": {"host": re.escape(f.get("host", "")), "path": f"^{re.escape(f.get('path',''))}"},
        "action": {
            "type": "map_local",
            "file": str(target.relative_to(ROOT)),
            "status": f.get("status") or 200,
            "content_type": f.get("resp_type") or "application/json",
        },
    }
    data = read_rules()
    data.setdefault("rules", [])
    data["rules"] = [r for r in data["rules"] if r.get("id") != rule["id"]]
    data["rules"].append(rule)
    write_rules(data)
    ok(f"mock body at {target}")
    ok(f"rule {rule['id']} added. Edit the file, then reload the screen in the app.")


# -------------------------------------------------------------------- mqtt
#
# The HTTP proxy cannot touch raw MQTT: the app opens its own TCP socket and
# bypasses the global http_proxy. So instead of intercepting the real broker,
# we run a local broker the app can point at, and publish into it by hand.
#
# The app connects over TLS (the Courier client forces the `ssl` scheme). A
# plain broker is refused at the handshake. So the local broker serves a leaf
# certificate signed by the mitmproxy CA. The device already trusts that CA in
# a debug build (the same CA `proxyctl cert` installs), so the TLS handshake
# succeeds with no extra taps.
#
# Flow for the user:
#   1. proxyctl mqtt broker            # start the local TLS broker + adb reverse
#   2. set the broker override in the app's debug settings to the printed URL
#   3. proxyctl mqtt pub <topic> <payload>   # push a message the app receives


def _mosquitto_bin(name="mosquitto"):
    found = shutil.which(name)
    if found:
        return found
    for base in ("/opt/homebrew/opt/mosquitto/sbin", "/opt/homebrew/bin",
                 "/usr/local/sbin", "/usr/local/bin"):
        cand = Path(base) / name
        if cand.exists():
            return str(cand)
    return None


def _openssl(*a, **kw):
    return subprocess.run(["openssl", *a], capture_output=True, text=True, **kw)


def _ensure_broker_certs():
    """Make the leaf cert the local broker serves, signed by the mitmproxy CA.

    Regenerate when missing, or when the mitmproxy CA changed under us (a fresh
    `mitmproxy` install rotates the CA, which would leave a stale leaf the
    device no longer trusts).
    """
    if not CA_KEY_PEM.exists():
        die(f"mitmproxy CA key not found at {CA_KEY_PEM}. Run `proxyctl start` "
            "once to generate it.")
    MQTT_DIR.mkdir(parents=True, exist_ok=True)

    ca_cert_src = CA_PEM.read_text()
    fresh = (
        MQTT_BROKER_CERT.exists()
        and MQTT_BROKER_KEY.exists()
        and MQTT_CA_CERT.exists()
        and MQTT_CA_CERT.read_text() == ca_cert_src
    )
    if fresh:
        return

    info("generating a broker certificate signed by the mitmproxy CA")
    MQTT_CA_CERT.write_text(ca_cert_src)
    ca_key = MQTT_DIR / "ca.key"
    res = _openssl("rsa", "-in", str(CA_KEY_PEM), "-out", str(ca_key))
    if res.returncode != 0:
        die(f"openssl could not read the CA key: {res.stderr.strip()}")
    res = _openssl("genrsa", "-out", str(MQTT_BROKER_KEY), "2048")
    if res.returncode != 0:
        die(f"openssl genrsa failed: {res.stderr.strip()}")
    csr = MQTT_DIR / "broker.csr"
    res = _openssl("req", "-new", "-key", str(MQTT_BROKER_KEY), "-out", str(csr),
                   "-subj", "/CN=127.0.0.1/O=dev-proxy-mqtt")
    if res.returncode != 0:
        die(f"openssl req failed: {res.stderr.strip()}")
    ext = MQTT_DIR / "broker.ext"
    ext.write_text("subjectAltName=IP:127.0.0.1,DNS:localhost\n"
                   "extendedKeyUsage=serverAuth\n")
    res = _openssl("x509", "-req", "-in", str(csr), "-CA", str(MQTT_CA_CERT),
                   "-CAkey", str(ca_key), "-CAcreateserial",
                   "-out", str(MQTT_BROKER_CERT), "-days", "3650",
                   "-extfile", str(ext))
    if res.returncode != 0:
        die(f"openssl x509 sign failed: {res.stderr.strip()}")
    for junk in (ca_key, csr, ext, MQTT_DIR / "ca.srl"):
        junk.unlink(missing_ok=True)
    try:
        MQTT_BROKER_KEY.chmod(0o600)
    except OSError:
        pass


def _mqtt_broker_pid():
    if not MQTT_PID_FILE.exists():
        return None
    try:
        pid = int(MQTT_PID_FILE.read_text().strip())
        os.kill(pid, 0)
    except (ValueError, OSError):
        return None
    return pid


def _mqtt_broker_start(cfg, port):
    if _mqtt_broker_pid():
        warn(f"local broker already runs on port {port} (pid {_mqtt_broker_pid()})")
        return
    mosq = _mosquitto_bin("mosquitto")
    if not mosq:
        die("mosquitto is not installed. Run `brew install mosquitto`.")
    _ensure_broker_certs()
    MQTT_CONF.write_text(
        f"listener {port} 0.0.0.0\n"
        "allow_anonymous true\n"
        f"cafile {MQTT_CA_CERT}\n"
        f"certfile {MQTT_BROKER_CERT}\n"
        f"keyfile {MQTT_BROKER_KEY}\n"
        "tls_version tlsv1.2\n"
        "require_certificate false\n"
    )
    with MQTT_LOG_FILE.open("a") as logfh:
        logfh.write(f"\n=== start {time.strftime('%Y-%m-%d %H:%M:%S')} ===\n")
        proc = subprocess.Popen(
            [mosq, "-c", str(MQTT_CONF)],
            stdout=logfh, stderr=subprocess.STDOUT, start_new_session=True,
        )
    time.sleep(0.6)
    if proc.poll() is not None:
        print(MQTT_LOG_FILE.read_text()[-1500:])
        die("mosquitto exited immediately. See the log above.")
    MQTT_PID_FILE.write_text(str(proc.pid))
    ok(f"local MQTT broker listens on 0.0.0.0:{port} (pid {proc.pid}), TLS via the mitmproxy CA")

    # Bridge the device to the Mac broker. adb reverse makes the phone's own
    # 127.0.0.1:<port> tunnel back here, so the broker override can stay
    # localhost and needs no LAN IP.
    if devices(cfg):
        adb(cfg, "reverse", f"tcp:{port}", f"tcp:{port}")
        ok(f"adb reverse tcp:{port} set, so the device reaches this broker on localhost")
    else:
        warn("no device attached, so adb reverse was skipped")
    print()
    print(f"  Set the broker override in the app to: {C['bold']}ssl://127.0.0.1:{port}{C['off']}")
    print("  (moj debug menu: Override Live MQTT broker), then restart the app.")
    print(f"  Publish with: proxyctl mqtt pub <topic> '<payload>'")
    print(f"  log: {MQTT_LOG_FILE}")


def _mqtt_broker_stop(cfg, port):
    pid = _mqtt_broker_pid()
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        MQTT_PID_FILE.unlink(missing_ok=True)
        ok(f"local broker stopped (pid {pid})")
    else:
        warn("local broker is not running")
        MQTT_PID_FILE.unlink(missing_ok=True)
    if devices(cfg):
        adb(cfg, "reverse", "--remove", f"tcp:{port}")


def _mqtt_publish(topic, payload, host, port, qos=1, retain=False,
                  tls=True, insecure=False):
    """Publish one message with mosquitto_pub. Returns (ok, message)."""
    pub = _mosquitto_bin("mosquitto_pub")
    if not pub:
        return False, "mosquitto_pub is not installed. Run `brew install mosquitto`."
    cmd = [pub, "-h", host, "-p", str(port), "-t", topic, "-m", payload,
           "-q", str(qos)]
    if retain:
        cmd.append("-r")
    if tls:
        cmd += ["--cafile", str(MQTT_CA_CERT)]
        if insecure:
            cmd.append("--insecure")
    res = subprocess.run(cmd, capture_output=True, text=True)
    if res.returncode != 0:
        return False, f"mosquitto_pub failed: {(res.stderr or res.stdout).strip()}"
    return True, f"published to {topic} on {host}:{port}"


def cmd_mqtt(cfg, args):
    port = args.port or MQTT_DEFAULT_PORT
    host = args.host or "127.0.0.1"

    if args.action == "broker":
        if args.stop:
            _mqtt_broker_stop(cfg, port)
        else:
            _mqtt_broker_start(cfg, port)
        return

    if args.action == "status":
        pid = _mqtt_broker_pid()
        if pid:
            ok(f"local broker running on port {port} (pid {pid})")
        else:
            info("local broker is not running")
        if devices(cfg):
            rev = adb(cfg, "reverse", "--list").stdout or ""
            state = "set" if f"tcp:{port}" in rev else "not set"
            info(f"adb reverse tcp:{port} is {state}")
        return

    if args.action == "pub":
        if not args.topic or args.payload is None:
            die("usage: proxyctl mqtt pub <topic> <payload>")
        ok_pub, msg = _mqtt_publish(args.topic, args.payload, host, port,
                                    args.qos, args.retain, args.tls, args.insecure)
        if not ok_pub:
            die(msg)
        ok(msg)
        return

    if args.action == "sub":
        if not args.topic:
            die("usage: proxyctl mqtt sub <topic>")
        sub = _mosquitto_bin("mosquitto_sub")
        if not sub:
            die("mosquitto_sub is not installed. Run `brew install mosquitto`.")
        cmd = [sub, "-h", host, "-p", str(port), "-t", args.topic, "-v"]
        if args.count:
            cmd += ["-C", str(args.count)]
        if args.timeout:
            cmd += ["-W", str(args.timeout)]
        cmd += ["--cafile", str(MQTT_CA_CERT)] if args.tls else []
        if args.tls and args.insecure:
            cmd.append("--insecure")
        info(f"watching {args.topic} on {host}:{port}. Press Ctrl-C to stop.")
        try:
            subprocess.run(cmd)
        except KeyboardInterrupt:
            print()
        return


# --------------------------------------------------------------------- cli

def main():
    cfg = load_config()
    p = argparse.ArgumentParser(prog="proxyctl", description=__doc__,
                               formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")

    sp = sub.add_parser("start", help="start the proxy")
    sp.add_argument("--port", type=int)
    sp.add_argument("--web", action="store_true", help="also serve the mitmweb UI")
    sp.add_argument("--insecure", action="store_true", help="do not verify upstream TLS")
    sp.add_argument("--upstream", help="chain to another proxy, host:port")
    sp.set_defaults(fn=cmd_start)

    for name, fn in (("stop", cmd_stop), ("status", cmd_status)):
        s = sub.add_parser(name, help=f"{name} the proxy")
        s.set_defaults(fn=fn)

    sp = sub.add_parser("restart", help="restart the proxy")
    sp.add_argument("--port", type=int)
    sp.add_argument("--web", action="store_true")
    sp.add_argument("--insecure", action="store_true")
    sp.add_argument("--upstream")
    sp.set_defaults(fn=cmd_restart)

    sp = sub.add_parser("setup", help="start, wire the device, install the certificate")
    sp.set_defaults(fn=cmd_setup)

    sp = sub.add_parser("update", help="pull the latest dev-proxy, refresh the skill and dashboard")
    sp.set_defaults(fn=cmd_update)

    sp = sub.add_parser("web", help="serve the live dashboard (flow list + inspector)")
    sp.add_argument("action", nargs="?", default="on", choices=["on", "off", "status"])
    sp.add_argument("--open", action="store_true", help="open it in the default browser")
    sp.set_defaults(fn=cmd_web)

    sp = sub.add_parser("_serve", help=argparse.SUPPRESS)
    sp.add_argument("port", type=int)
    sp.set_defaults(fn=cmd_serve_dashboard)

    sp = sub.add_parser("device", help="route device traffic through the proxy")
    sp.add_argument("action", choices=["on", "off"])
    sp.add_argument("--lan", nargs="?", const=True,
                    help="use the Mac LAN IP instead of adb reverse")
    sp.set_defaults(fn=cmd_device)

    sp = sub.add_parser("cert", help="install the mitmproxy CA on the device")
    sp.add_argument("mode", nargs="?", default="user",
                    choices=["user", "system", "path", "verify"])
    sp.add_argument("--wait", type=int, default=25)
    sp.set_defaults(fn=lambda c, a: cmd_cert_verify(c, a) if a.mode == "verify" else cmd_cert(c, a))

    sp = sub.add_parser("flows", help="list captured traffic")
    sp.add_argument("--last", type=int, default=40)
    sp.add_argument("--host"); sp.add_argument("--url"); sp.add_argument("--method")
    sp.add_argument("--status"); sp.add_argument("--grep")
    sp.add_argument("--min-ms", type=int, dest="min_ms")
    sp.add_argument("--errors", action="store_true", help="only failed flows")
    sp.add_argument("--mocked", action="store_true", help="only flows a rule touched")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(fn=cmd_flows)

    sp = sub.add_parser("show", help="show one flow in full")
    sp.add_argument("id")
    sp.add_argument("--full", action="store_true", help="print whole bodies")
    sp.add_argument("--body-only", action="store_true")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(fn=cmd_show)

    sp = sub.add_parser("body", help="print the path of a saved body file")
    sp.add_argument("id"); sp.add_argument("side", choices=["req", "resp"])
    sp.set_defaults(fn=cmd_body)

    sp = sub.add_parser("paths", help="list dotted JSON paths in a response body")
    sp.add_argument("id")
    sp.add_argument("query", nargs="?", help="case-insensitive filter on the path")
    sp.add_argument("--limit", type=int, default=200)
    sp.set_defaults(fn=cmd_paths)

    sp = sub.add_parser("clear", help="delete the flow log and saved bodies")
    sp.set_defaults(fn=cmd_clear)

    sp = sub.add_parser("tail", help="follow new flows live")
    sp.set_defaults(fn=cmd_tail)

    sp = sub.add_parser("rules", help="manage interception rules")
    sp.add_argument("action", choices=["list", "add", "rm", "remove", "enable",
                                      "disable", "clear", "capture"])
    sp.add_argument("id", nargs="*")
    sp.add_argument("--json", help="rule JSON, or read from stdin")
    sp.set_defaults(fn=cmd_rules)

    sp = sub.add_parser("mock", help="turn a captured response into a map-local rule")
    sp.add_argument("id")
    sp.add_argument("--name"); sp.add_argument("--rule-id")
    sp.set_defaults(fn=cmd_mock)

    sp = sub.add_parser("map", help="serve a URL from a local file you edit live")
    sp.add_argument("host", help="host to match, e.g. api.example.com")
    sp.add_argument("path", help="path to match, e.g. /v1/feed")
    sp.add_argument("--file", help="the mapping file (default: maps/<derived>.json)")
    sp.add_argument("--status", type=int, default=200)
    sp.add_argument("--content-type", dest="content_type", default="application/json")
    sp.add_argument("--name"); sp.add_argument("--rule-id")
    sp.add_argument("--regex", action="store_true",
                    help="treat host and path as regexes instead of literals")
    sp.set_defaults(fn=cmd_map)

    sp = sub.add_parser("replay", help="send a captured request again")
    sp.add_argument("id"); sp.add_argument("--timeout", type=int, default=30)
    sp.set_defaults(fn=cmd_replay)

    sp = sub.add_parser("har", help="export captured traffic as HAR")
    sp.add_argument("out")
    sp.set_defaults(fn=cmd_har)

    sp = sub.add_parser("app", help="start or stop the app under test")
    sp.add_argument("action", choices=["start", "stop", "restart"])
    sp.add_argument("--package")
    sp.set_defaults(fn=cmd_app)

    sp = sub.add_parser("mqtt", help="run a local MQTT broker and publish to it")
    sp.add_argument("action", choices=["broker", "pub", "sub", "status"])
    sp.add_argument("topic", nargs="?", help="topic for pub/sub")
    sp.add_argument("payload", nargs="?", help="message payload for pub")
    sp.add_argument("--stop", action="store_true", help="broker: stop it")
    sp.add_argument("--host", help="broker host (default 127.0.0.1)")
    sp.add_argument("--port", type=int, help=f"broker port (default {MQTT_DEFAULT_PORT})")
    sp.add_argument("--qos", type=int, default=1, choices=[0, 1, 2])
    sp.add_argument("--retain", action="store_true", help="pub: set the retain flag")
    sp.add_argument("--count", type=int, help="sub: stop after N messages")
    sp.add_argument("--timeout", type=int, help="sub: stop after N seconds")
    sp.add_argument("--no-tls", dest="tls", action="store_false",
                    help="talk plain TCP instead of TLS (a non-default broker)")
    sp.add_argument("--insecure", action="store_true",
                    help="TLS without verifying the broker certificate")
    sp.set_defaults(fn=cmd_mqtt, tls=True)

    args = p.parse_args()
    if not getattr(args, "fn", None):
        p.print_help()
        return
    args.fn(cfg, args)


if __name__ == "__main__":
    main()
